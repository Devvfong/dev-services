# DevServices Git Ignore Rules

# Compiled binaries and bundle outputs
/dist/*.dll
/dist/*.pdb
!/dist/DevServices.exe
!/dist/DevServices.standalone.ps1

# Local environment & config
.devservices_config.json
*.local.json

# Node & Next.js
node_modules/
.next/
out/

# Temporary files and logs
*.log
*.tmp
*.temp

# IDE & Editor settings
.vscode/
.idea/
*.suo
*.user
